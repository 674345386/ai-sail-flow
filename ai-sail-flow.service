[Unit]
Description=AI-Sail Flow application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ai-sail-flow
EnvironmentFile=/opt/ai-sail-flow/.env.production
Environment=NODE_ENV=production
Environment=SOP_REQUIRE_AUTH=true
Environment=SOP_HOST=127.0.0.1
Environment=SOP_PORT=4317
Environment=SOP_DATA_DIR=/opt/ai-sail-flow/data
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
