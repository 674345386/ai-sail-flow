{
  "name": "sop-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_USE_ENV_PROXY=1 tsx server/index.ts --production",
    "check": "tsc --noEmit",
    "smoke": "NODE_USE_ENV_PROXY=1 node --import tsx scripts/smoke.ts",
    "check:veo": "node --import tsx scripts/veo-check.ts",
    "check:compose": "node --import tsx scripts/compose-check.ts",
    "check:workflow": "node --import tsx scripts/workflow-check.ts"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@paper-design/shaders-react": "0.0.81",
    "@supabase/supabase-js": "^2.116.0",
    "@xyflow/react": "^12.12.0",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^22.1.0",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.46.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^8.12.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
