{
  "name": "person-turntable-remotion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "render:fashion": "remotion render src/index.tsx FashionColorShowcase out/model-fashion-colors.mp4 --codec=h264 --crf=18 --concurrency=2",
