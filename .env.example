# Server-side only. Alternatively connect for this session in the app settings.
GEMINI_API_KEY=
SOP_PORT=4317
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY is server-only; it is not needed for the first client login phase.
# Optional compatibility gateway for static video/image analysis and text rewriting.
# SOP_GEMINI_BASE_URL=https://maiai.ai/v1
# Veo 3.1 at https://gaorui.cc/v1/videos. Keep separate from the Gemini gateway key.
# SOP_VEO_API_KEY=
# Default video analysis sends inline video with media_processing=AGENTIC to generateContent.
# The configured Gemini gateway must pass through this Gemini-native Part field.
# Explicit legacy modes: static (full video, one-pass) or frames (images only, compatible gateway).
# SOP_VIDEO_ANALYSIS_MODE=agentic
# Optional absolute path. Defaults to ./data.
# SOP_DATA_DIR=
