# Server-side only. Alternatively connect for this session in the app settings.
GEMINI_API_KEY=
# Independent GPT Responses API (server-only).
# SOP_GPT_API_KEY=
# SOP_GPT_BASE_URL=https://maiai.ai
# SOP_GPT_MODEL=gpt-6.1-sol
# Supported models: gpt-6.1-sol, gpt-6.1-terra.
# Independent Images API for generated character images. Configure in the app instead if preferred.
# SOP_IMAGE_API_KEY=
# SOP_IMAGE_BASE_URL=https://api.qzftech.top/v1
# SOP_IMAGE_MODEL=gpt-image-2.6-flare
SOP_PORT=4317
# Agent mode: Codex app-server + a replaceable Responses API provider (server-only).
# deepseek-flash is the API ID for DeepSeek-V4.1-Flash-1017.
SOP_AGENT_PROVIDER=deepseek
SOP_AGENT_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# SOP_AGENT_BASE_URL=https://api.deepseek.com
# SOP_AGENT_API_KEY_ENV=DEEPSEEK_API_KEY
# SOP_AGENT_EFFORT=high
# Optional model metadata file for another provider (absolute path).
# SOP_AGENT_MODEL_CATALOG=/absolute/path/to/models.json
# To use the isolated Codex login instead: SOP_AGENT_PROVIDER=codex,
# SOP_AGENT_MODEL=gpt-6.1-terra. Other providers need BASE_URL, MODEL and API_KEY_ENV.
# SOP_AGENT_CODEX_BIN=/absolute/path/to/codex
# SOP_AGENT_CODEX_HOME=/absolute/path/to/isolated-codex-home
# Local-only programmatic video coding/rendering; hosted mode always disables it.
# SOP_AGENT_PROGRAMMATIC_ENABLED=false
# Optional local proxy. Loaded by the server before initializing outgoing requests.
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1,::1
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public deployment: set both VITE_* values at build time and server-side values at runtime.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SOP_REQUIRE_AUTH=false
SOP_ALLOWED_HOSTS=lululib.cn,www.lululib.cn
PUBLIC_DOMAIN=lululib.cn
SOP_HOST=127.0.0.1
VITE_SUPABASE_STORAGE_BUCKET=ai-sail-flow-files
# Optional. Defaults to the current website origin + /auth/callback.
# Add the exact callback URL to Supabase Authentication's redirect allowlist.
# VITE_AUTH_REDIRECT_URL=http://127.0.0.1:4317/auth/callback
# SMTP and WeChat AppID/AppSecret belong in Supabase's Auth console, not VITE_ variables.
# SUPABASE_SECRET_KEY is server-only; it is not needed for the first client login phase.
# Optional compatibility gateway for static video/image analysis and text rewriting.
# SOP_GEMINI_BASE_URL=https://maiai.ai/v1
# Veo 3.1 at https://gaorui.cc/v1/videos. Keep separate from the Gemini gateway key.
# SOP_VEO_API_KEY=
# Independent MiniMax H3 provider via Hi/SparkCine native API (server-only).
# SOP_MINIMAX_API_KEY=
# SOP_MINIMAX_BASE_URL=https://hi.hi.run/api/open/v1
# Default video analysis sends inline video with media_processing=AGENTIC to generateContent.
# The configured Gemini gateway must pass through this Gemini-native Part field.
# Explicit legacy modes: static (full video, one-pass) or frames (images only, compatible gateway).
# SOP_VIDEO_ANALYSIS_MODE=static
# Recreation keyframes use the independent Images API above with reference images.
# The configured image gateway must support POST /v1/images/edits with multiple images.
# Server-only private storage for image-to-video inputs; never prefix the secret with VITE_.
# Uses VITE_SUPABASE_URL for the existing project unless SUPABASE_URL is provided.
# SUPABASE_SECRET_KEY=
# SOP_KEYFRAME_BUCKET=sop-keyframes
# Optional absolute path. Defaults to ./data.
# SOP_DATA_DIR=

# Hotspot research radar: public Google Trends / Google News RSS require no key.
# Server-side credentials and optional existing data feeds (never use VITE_ prefixes).
# SOP_RADAR_X_BEARER_TOKEN=
# SOP_RADAR_YOUTUBE_API_KEY=
# SOP_RADAR_TIKTOK_FEED_URL=
# SOP_RADAR_AMAZON_FEED_URL=
# SOP_RADAR_RSSHUB_FEED_URL=
# Optional: read already collected Apify datasets; no Actor runs are started.
# SOP_RADAR_APIFY_TOKEN=
# SOP_RADAR_TIKTOK_DATASET_ID=
# SOP_RADAR_AMAZON_DATASET_ID=
